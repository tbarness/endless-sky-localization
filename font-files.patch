+		if((previous < 0x80 && !isalnum(static_cast<int>(previous))) || (c < 0x80 && !isalnum(static_cast<int>(c))))
+			return false;
+		return NO_BREAK_BEFORE.find(c) == u32string_view::npos && NO_BREAK_AFTER.find(previous) == u32string_view::npos;
+	}
+}
